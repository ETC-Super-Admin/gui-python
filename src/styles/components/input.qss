/* Input Fields - Enhanced */
QLineEdit, QTextEdit, QPlainTextEdit {{
    background-color: {CARD};
    color: {FOREGROUND};
    border: 1px solid {INPUT};
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 16px;
}}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {{
    border: 2px solid {RING};
    background-color: white;
    color: #020817; /* Set text to black on focus */
}}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {{
    border-color: #cbd5e1;
}}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {{
    background-color: {MUTED};
    color: {MUTED_FOREGROUND};
}}

/* ComboBox - Enhanced */
QComboBox {{
    background-color: {CARD};
    color: {FOREGROUND};
    border: 1px solid {INPUT};
    border-radius: 6px;
    padding: 6px 10px;
    padding-left: 10px;
    min-height: 16px;
}}

QComboBox:focus {{
    border: 2px solid {RING};
    background-color: white;
    color: #020817; /* Set text to black on focus */
}}

QComboBox:hover {{
    border-color: #cbd5e1;
}}

QComboBox:disabled {{
    background-color: {MUTED};
    color: {MUTED_FOREGROUND};
}}

/* ComboBox Dropdown */
QComboBox::drop-down {{
    border: none;
    padding-right: 8px;
}}

QComboBox QAbstractItemView {{
    background-color: {CARD};
    border: 1px solid {BORDER};
    border-radius: 6px;
    selection-background-color: {PRIMARY};
    selection-color: {PRIMARY_FOREGROUND};
    outline: 0px;
    padding: 4px;
}}

QComboBox QAbstractItemView::item {{
    padding: 8px 12px;
    border-radius: 4px;
    min-height: 24px;
    color: {FOREGROUND}; /* Explicitly set default text color */
}}

QComboBox QAbstractItemView::item:hover {{
    background-color: {SECONDARY};
    color: {ACCENT_FOREGROUND}; /* Explicitly set text color on hover */
}}

/* SpinBox - Enhanced */
QSpinBox {{
    background-color: {CARD};
    color: {FOREGROUND};
    border: 1px solid {INPUT};
    border-radius: 6px;
    padding: 8px 12px;
    min-height: 20px;
}}

QSpinBox:focus {{
    border: 2px solid {RING};
    background-color: white;
    color: #020817;
}}

QSpinBox:hover {{
    border-color: #cbd5e1;
}}

/* Custom SpinBox */
#CustomSpinBox QLineEdit#SpinBoxLineEdit {{
    border: 1px solid {INPUT};
    border-right: none;
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    background-color: {CARD};
    color: {FOREGROUND};
    padding: 6px 10px;
    min-height: 16px;
}}
#CustomSpinBox QLineEdit#SpinBoxLineEdit:focus {{
    border: 2px solid {RING};
    border-right: none;
    background-color: white;
    color: #020817;
}}

#CustomSpinBox QPushButton#PlusSpinBoxButton {{
    background-color: {SECONDARY};
    border: 1px solid {INPUT};
    border-left: 1px solid {BORDER};
    border-right: none;
    border-radius: 0px;
    padding: 6px;
    min-height: 16px;
}}

#CustomSpinBox QPushButton#MinusSpinBoxButton {{
    background-color: {SECONDARY};
    border: 1px solid {INPUT};
    border-left: 1px solid {BORDER};
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    padding: 6px;
    min-height: 16px;
}}

#CustomSpinBox QPushButton:hover {{
    background-color: {HOVER};
}}


/* Splitter Handle */
/* QSplitter::handle {{
    background-color: transparent;
}} */
QSplitter::handle:horizontal {{
    image: url(public/grip-vertical.svg);
    background-repeat: no-repeat;
    background-position: center center;
}}
/* QSplitter::handle:hover {{
    background-color: {HOVER};
}}
QSplitter::handle:pressed {{
    background-color: {RING};
}} */

/* DateEdit - Panel Style */
QDateEdit {{
    background-color: {CARD};
    color: {FOREGROUND};
    border: 1px solid {INPUT};
    border-radius: 6px;
    padding: 8px 12px;
    min-height: 20px;
}}

QDateEdit:focus {{
    border: 2px solid {RING};
    background-color: white;
    color: #020817;
}}

QDateEdit:hover {{
    border-color: #cbd5e1;
}}

QDateEdit::drop-down {{
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left-width: 1px;
    border-left-color: {BORDER};
    border-left-style: solid;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    image: url(public/calendar.svg);
}}



/* Calendar Widget Popup - Panel Style */
QCalendarWidget {{
    min-width: 300px;
    min-height: 260px;
}}

QCalendarWidget QWidget#qt_calendar_navigationbar {{
    background-color: {SECONDARY};
    border: 1px solid {BORDER};
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 4px;
}}

QCalendarWidget QToolButton {{
    background-color: transparent;
    border: none;
    color: {FOREGROUND};
    font-size: 14px;
    padding: 5px;
    margin: 2px;
    border-radius: 4px;
}}

QCalendarWidget QToolButton:hover {{
    background-color: {HOVER};
}}

QCalendarWidget QMenu {{
    background-color: {CARD};
    border: 1px solid {BORDER};
}}

QCalendarWidget QMenu::item:selected {{
    background-color: {PRIMARY};
}}

QCalendarWidget QSpinBox {{
    background-color: {CARD};
    border: 1px solid {BORDER};
    border-radius: 4px;
    color: {FOREGROUND};
}}

QCalendarWidget QTableView {{
    background-color: {CARD};
    border: none;
}}

QCalendarWidget QTableView::item {{
    background-color: transparent;
    color: {FOREGROUND};
    padding: 2px;
}}

QCalendarWidget QTableView::item:hover {{
    background-color: {HOVER};
    border-radius: 4px;
}}

QCalendarWidget QTableView::item:selected, QCalendarWidget QTableView::item:selected:focus {{
    background-color: {PRIMARY};
    color: {PRIMARY_FOREGROUND};
    border-radius: 4px;
    border: 1px solid {PRIMARY};
    outline: 0px;
}}

QCalendarWidget QHeaderView::section {{
    background-color: {SECONDARY};
    color: {MUTED_FOREGROUND};
    font-weight: bold;
    padding: 6px;
    border: none;
}}

QCalendarWidget QTableView#qt_calendar_calendarview::item:disabled {{
    color: {MUTED_FOREGROUND};
}}